# Copy to .env for local use. On Vercel, add these under Project > Settings > Environment Variables.

# api-football.com key: every football league worldwide (falls back to ESPN when empty)
API_FOOTBALL_KEY=

# First owner account for /admin, created automatically when the database has no admins yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Long random string used to sign admin logins (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_SECRET=

# Database (one is required on Vercel; leave all empty locally to use SQLite at data/scorenest.db).
# Supabase: project URL + the secret / service-role key (server only). Run supabase/schema.sql once.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Or any Postgres connection string (e.g. Neon); tables are created automatically.
DATABASE_URL=
