{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 60, "includeFiles": "lib/**" }
  },
  "rewrites": [
    { "source": "/api/:path(.*)", "destination": "/api/index?__path=/api/:path" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
